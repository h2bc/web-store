{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless", "--browser", "chromium"]
    },
    "nextcloud": {
      "command": "uvx",
      "args": [
        "--env-file",
        ".devcontainer/.env",
        "nextcloud-mcp-server",
        "run",
        "--transport",
        "stdio",
        "--enable-app",
        "deck",
        "--enable-app",
        "collectives",
        "--enable-app",
        "webdav"
      ]
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp"
    }
  }
}
