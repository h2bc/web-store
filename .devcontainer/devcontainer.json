{
  "name": "h2bc-web-store-dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "mounts": [
    "type=bind,source=${localWorkspaceFolder},target=/workspace",
    "type=bind,source=${localEnv:HOME}/.claude,target=/claude"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "node"
    },
    "ghcr.io/devcontainers-extra/features/pnpm:2": {
      "version": "10"
    },
    "ghcr.io/schlich/devcontainer-features/playwright:0": {
      "browsers": "chromium"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/nullcoder/devcontainer-features/stripe-cli:1": {},
    "ghcr.io/jrussellsmyth/devcontainer-features/openspec:1": {}
  },
  "remoteEnv": {
    "CLAUDE_CONFIG_DIR": "/claude"
  },
  "postCreateCommand": "pnpm i --frozen && pnpm install:api && pnpm install:front && pnpm migrate",
  "runServices": ["db", "redis"],
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-ossdata.vscode-pgsql",
        "github.vscode-github-actions",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "jackiotyu.git-worktree-manager"
      ]
    }
  },
  "remoteUser": "node"
}
