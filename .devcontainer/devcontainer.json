{
  "name": "h2bc-web-dev",
  "image": "node:25",
  "workspaceFolder": "/workspace",
  "runArgs": ["--network=h2bc-web-dev"],
  "mounts": [
    "type=bind,source=${localWorkspaceFolder},target=/workspace",
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent.sock,type=bind",
    "type=bind,source=${localEnv:HOME}/.claude,target=/claude"
  ],
  "postCreateCommand": "pnpm i --frozen",
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent.sock",
    "CLAUDE_CONFIG_DIR": "/claude"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "node"
    },
    "ghcr.io/devcontainers-extra/features/pnpm:2": {
      "version": "10"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "github.vscode-github-actions",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "remoteUser": "node"
}
